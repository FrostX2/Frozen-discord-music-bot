= require('dotnet');\r\ndotnet.new().restore().build().publish();\r\n```\r\n\r\n### Running multiple commands - series\r\n\r\n```\r\nvar dotnet = require('dotnet');\r\ndotnet.series(['new','restore','build','publish']);\r\n```\r\n\r\n","maintainers":[{"name":"jonathan.haker","email":"jhaker@yahoo.com"}],"time":{"modified":"2022-06-15T22:39:33.891Z","created":"2016-02-25T09:09:30.328Z","1.0.0":"2016-02-25T09:09:30.328Z","1.0.1":"2016-02-25T19:02:21.558Z","0.0.1":"2016-10-20T13:14:52.697Z","0.0.3":"2016-10-23T18:56:31.870Z","0.0.4":"2016-10-23T19:06:42.024Z","0.0.5":"2016-10-24T15:25:09.119Z","1.1.0":"2016-11-19T13:03:28.670Z","1.1.1":"2016-11-19T14:54:21.597Z","1.1.2":"2016-11-19T14:55:58.478Z","1.1.3":"2016-12-02T10:37:36.457Z","1.1.4":"2017-08-17T07:32:05.307Z"},"author":{"name":"jonathan haker"},"license":"MIT","readmeFilename":"README.md","homepage":"https://github.com/jhaker/nodejs-dotnet#readme","keywords":["dotnet","ASP.NET Core",".NET Core",".NET","CLI","dotnet commands",".NET commands"],"repository":{"type":"git","url":"git+https://github.com/jhaker/nodejs-dotnet.git"},"bugs":{"url":"https://github.com/jhaker/nodejs-dotnet/issues"},"users":{"cab1729":true}}