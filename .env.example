# Required
DISCORD_TOKEN=your_bot_token_here
CLIENT_ID=your_application_id_here

# Optional (slash commands scope to specific guild for instant registration)
GUILD_ID=
PREFIX=!

# --- External Lavalink (bypass local NodeLink as main) ---
# Set LAVALINK_HOST to use a remote server as the main node.
# Local NodeLink is still started and used as the bottom fallback node.
# Global (US-friendly), good uptime:
# LAVALINK_HOST=lavalink-v4.triniumhost.com
# LAVALINK_PORT=443
# LAVALINK_PASSWORD=free
# LAVALINK_SECURE=true

# --- NodeLink (self-hosted audio server, bottom fallback node) ---
# Always started unless SKIP_NODELINK=true. Used as the last-resort node,
# and as the only node when no external Lavalink is configured.
# These are the defaults — only set to override
# NODELINK_PORT=2333
# NODELINK_PASSWORD=youshallnotpass
# NODELINK_LOG_LEVEL=info
# SKIP_NODELINK=false

# --- Auto-reconnect (when all nodes are down) ---
# Cooldown between auto-reconnect attempts (ms). Use /reconnect anytime to bypass.
RECONNECT_COOLDOWN=900000
# How often to check whether to auto-reconnect (ms)
RECONNECT_CHECK_INTERVAL=60000

# --- Alternative Lavalink (failover when main node is down) ---
# Optional backup nodes. When the main node disconnects, active players
# auto-move to the first connected alt node. Indexed env vars per node
# (index 1..5 shown, up to 10 supported):
# ALT_LAVALINK_HOST_1=alt1.example.com
# ALT_LAVALINK_PORT_1=443
# ALT_LAVALINK_PASSWORD_1=pass1
# ALT_LAVALINK_SECURE_1=true
# ALT_LAVALINK_TYPE_1=Lavalink   # Lavalink (Java) or NodeLink
# ALT_LAVALINK_ID_1=alt1         # optional custom node id
#
# ALT_LAVALINK_HOST_2=alt2.example.com
# ALT_LAVALINK_PORT_2=443
# ALT_LAVALINK_PASSWORD_2=pass2
# ALT_LAVALINK_SECURE_2=true
# ALT_LAVALINK_TYPE_2=Lavalink
# ALT_LAVALINK_ID_2=alt2
#
# ALT_LAVALINK_HOST_3=alt3.example.com
# ALT_LAVALINK_PORT_3=443
# ALT_LAVALINK_PASSWORD_3=pass3
# ALT_LAVALINK_SECURE_3=true
# ALT_LAVALINK_TYPE_3=Lavalink
# ALT_LAVALINK_ID_3=alt3
#
# ALT_LAVALINK_HOST_4=alt4.example.com
# ALT_LAVALINK_PORT_4=443
# ALT_LAVALINK_PASSWORD_4=pass4
# ALT_LAVALINK_SECURE_4=true
# ALT_LAVALINK_TYPE_4=Lavalink
# ALT_LAVALINK_ID_4=alt4
#
# ALT_LAVALINK_HOST_5=alt5.example.com
# ALT_LAVALINK_PORT_5=443
# ALT_LAVALINK_PASSWORD_5=pass5
# ALT_LAVALINK_SECURE_5=true
# ALT_LAVALINK_TYPE_5=Lavalink
# ALT_LAVALINK_ID_5=alt5
#
# Optional per node (all default to sane values):
#   port     - default 443 (or 80 if secure=false)
#   password - default LAVALINK_PASSWORD
#   secure   - default true
#   type     - default Lavalink
#   id       - default alt<index>
#
# Node order: main -> alt1..alt5 -> nodelink (bottom fallback, always present).
# If main + alts are all commented out, only the local NodeLink is used.

# Render
# PORT=3000

# --- Web Admin Panel ---
# Public status page is at / (no login). Admin dashboard is at /admin.
# WEB_PORT=13426
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=admin123
# SESSION_SECRET=